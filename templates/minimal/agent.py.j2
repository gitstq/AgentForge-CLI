class AgentContext:
    """
    Isolated context management for the agent.

    Separates system prompts, user messages, and tool results
    to maintain clean context boundaries (12-Factor: Context Isolation).
    """

    def __init__(self) -> None:
        self.system_prompt: str = ""
        self.user_messages: List[Dict[str, str]] = []
        self.tool_results: List[Dict[str, Any]] = []
        self.history: List[Dict[str, Any]] = []

    def add_system_message(self, content: str) -> None:
        """Set the system prompt for the agent."""
        self.system_prompt = content
        logger.info("System prompt updated (%d chars)", len(content))

    def add_user_message(self, content: str) -> None:
        """Add a user message to the context."""
        msg = {"role": "user", "content": content}
        self.user_messages.append(msg)
        self.history.append(msg)
        logger.debug("User message added: %s", content[:50])

    def add_tool_result(self, tool_name: str, result: Any) -> None:
        """Add a tool execution result to the context."""
        msg = {"role": "tool", "name": tool_name, "content": str(result)}
        self.tool_results.append(msg)
        self.history.append(msg)
        logger.info("Tool result added from %s", tool_name)

    def get_messages(self) -> List[Dict[str, Any]]:
        """Return the full message history for the LLM API call."""
        messages = []
        if self.system_prompt:
            messages.append({"role": "system", "content": self.system_prompt})
        messages.extend(self.history)
        return messages

    def clear(self) -> None:
        """Clear all context except the system prompt."""
        self.user_messages.clear()
        self.tool_results.clear()
        self.history.clear()
        logger.info("Context cleared")


class Agent:
    """
    Main agent class with explicit control flow and state management.

    Implements the core agent loop:
    1. Receive user input
    2. Decide whether to use a tool or respond directly
    3. Execute tool if needed (with retry logic)
    4. Generate final response
    """

    def __init__(self, settings: Optional[Settings] = None) -> None:
        self.settings = settings or Settings()
        self.context = AgentContext()
        self.tools = ToolRegistry()
        self.state: Dict[str, Any] = {}
        self.max_iterations: int = 10

        # Initialize system prompt
        self.context.add_system_message(
            "You are a helpful AI assistant. Use the available tools "
            "to help the user. Always provide clear, concise responses."
        )

        logger.info("Agent initialized with %d tools", len(self.tools.list_tools()))

    def run(self, user_input: str) -> str:
        """
        Run the agent with the given user input.

        Args:
            user_input: The user's message or query.

        Returns:
            The agent's response as a string.
        """
        self.context.add_user_message(user_input)

        iteration = 0
        while iteration < self.max_iterations:
            iteration += 1
            logger.info("Agent iteration %d/%d", iteration, self.max_iterations)

            # Get the current context for the LLM
            messages = self.context.get_messages()

            try:
                # TODO: Replace with actual LLM API call
                response = self._call_llm(messages)
                logger.debug("LLM response: %s", response[:100])

                # Check if the agent wants to use a tool
                tool_call = self._parse_tool_call(response)
                if tool_call:
                    tool_name = tool_call["name"]
                    tool_args = tool_call.get("arguments", {})

                    logger.info("Executing tool: %s", tool_name)
                    result = self._execute_tool_with_retry(tool_name, tool_args)
                    self.context.add_tool_result(tool_name, result)
                    continue

                # No tool call -- return the response
                return response

            except Exception as e:
                logger.error("Error in agent loop: %s", e)
                return f"An error occurred: {e}. Please try again."

        return "I was unable to complete your request within the maximum number of iterations."

