"""
Configuration management for {project_name}.

Uses environment variables for all sensitive values, with sensible defaults
for development. Follows the 12-Factor Agent methodology for configuration.
"""

import os
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Settings:
    """
    Application settings loaded from environment variables.

    All configuration is externalized -- no hardcoded secrets.
    Set values via environment variables or a .env file.
    """

    # LLM Configuration
    llm_provider: str = field(default_factory=lambda: os.getenv("LLM_PROVIDER", "openai"))
    llm_model: str = field(default_factory=lambda: os.getenv("LLM_MODEL", "gpt-4"))
    llm_api_key: str = field(default_factory=lambda: os.getenv("LLM_API_KEY", ""))
    llm_base_url: Optional[str] = field(
        default_factory=lambda: os.getenv("LLM_BASE_URL", None)
    )
    llm_temperature: float = field(
        default_factory=lambda: float(os.getenv("LLM_TEMPERATURE", "0.7"))
    )
    llm_max_tokens: int = field(
        default_factory=lambda: int(os.getenv("LLM_MAX_TOKENS", "2048"))
    )

    # Agent Configuration
    max_iterations: int = field(
        default_factory=lambda: int(os.getenv("MAX_ITERATIONS", "10"))
    )
    max_retries: int = field(
        default_factory=lambda: int(os.getenv("MAX_RETRIES", "3"))
    )
    verbose_logging: bool = field(
        default_factory=lambda: os.getenv("VERBOSE_LOGGING", "false").lower() == "true"
    )

    # Memory Configuration
    memory_backend: str = field(
        default_factory=lambda: os.getenv("MEMORY_BACKEND", "json")
    )
    memory_file: str = field(
        default_factory=lambda: os.getenv("MEMORY_FILE", "memory.json")
    )
    memory_max_entries: int = field(
        default_factory=lambda: int(os.getenv("MEMORY_MAX_ENTRIES", "1000"))
    )

    # Application
    app_name: str = "{project_name}"
    app_version: str = "{version}"
    debug: bool = field(
        default_factory=lambda: os.getenv("DEBUG", "false").lower() == "true"
    )

    def validate(self) -> list:
        """Validate that required settings are present."""
        errors = []

        if not self.llm_api_key:
            errors.append("LLM_API_KEY is required. Set it in your .env file.")

        if self.llm_temperature < 0 or self.llm_temperature > 2:
            errors.append("LLM_TEMPERATURE must be between 0 and 2.")

        if self.max_iterations < 1:
            errors.append("MAX_ITERATIONS must be at least 1.")

        if self.memory_backend not in ("json", "redis", "sqlite"):
            errors.append("MEMORY_BACKEND must be one of: json, redis, sqlite")

        return errors


def load_settings() -> Settings:
    """
    Load settings from environment variables.

    Optionally loads a .env file if python-dotenv is available.
    """
    try:
        from dotenv import load_dotenv
        load_dotenv()
    except ImportError:
        pass

    settings = Settings()
    errors = settings.validate()
    if errors:
        import logging
        logger = logging.getLogger(__name__)
        for err in errors:
            logger.warning("Configuration issue: %s", err)

    return settings
