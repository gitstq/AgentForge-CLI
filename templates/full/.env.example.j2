# {project_name} - Environment Variables
# Copy this file to .env and fill in the values

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Agent Configuration
MAX_ITERATIONS=10
MAX_RETRIES=3
VERBOSE_LOGGING=false
DEBUG=false

# Memory Configuration
MEMORY_BACKEND=json
MEMORY_FILE=memory.json
MEMORY_MAX_ENTRIES=1000
