"""
Prompt management for {project_name}.

Centralizes all prompt templates in one place for easy maintenance
and consistency. Supports variable substitution for dynamic prompts.
"""

import logging
import re
from typing import Any, Dict, Optional

logger = logging.getLogger(__name__)


class PromptManager:
    """
    Manages prompt templates with variable substitution.

    Prompts are stored as string templates with {variable} placeholders
    that can be filled in at runtime.
    """

    def __init__(self) -> None:
        self._templates: Dict[str, str] = {}
        self._register_defaults()
        logger.info("PromptManager initialized with %d templates", len(self._templates))

    def _register_defaults(self) -> None:
        """Register the default prompt templates."""
        self._templates["system"] = (
            "You are {agent_name}, a helpful AI assistant. "
            "You have access to various tools to help users. "
            "Always think step-by-step and provide clear, actionable responses. "
            "If you use a tool, explain what you're doing and why."
        )

        self._templates["error_fallback"] = (
            "I encountered an error while processing your request: {error_message}\n\n"
            "Please try rephrasing your question or try again later."
        )

        self._templates["tool_use"] = (
            "I'll use the {tool_name} tool to help with that.\n"
            "Parameters: {parameters}"
        )

        self._templates["summarize"] = (
            "Please summarize the following conversation:\n\n"
            "{conversation_history}\n\n"
            "Provide a concise summary covering the key points discussed."
        )

    def register(self, name: str, template: str) -> None:
        """
        Register a new prompt template.

        Args:
            name: Unique template name.
            template: Template string with {variable} placeholders.
        """
        self._templates[name] = template
        logger.debug("Prompt template registered: %s", name)

    def get_prompt(self, name: str, **kwargs: Any) -> str:
        """
        Get a prompt template with variables substituted.

        Args:
            name: Name of the template.
            **kwargs: Variables to substitute into the template.

        Returns:
            The rendered prompt string.

        Raises:
            KeyError: If the template name is not found.
        """
        if name not in self._templates:
            raise KeyError(f"Prompt template '{name}' not found.")

        template = self._templates[name]
        try:
            return template.format(**kwargs)
        except KeyError as e:
            logger.warning("Missing variable %s in template %s", e, name)
            return template  # Return unsubstituted template

    def list_templates(self) -> Dict[str, str]:
        """Return all registered template names and their raw content."""
        return dict(self._templates)

    def update_template(self, name: str, template: str) -> None:
        """
        Update an existing prompt template.

        Args:
            name: Name of the template to update.
            template: New template string.
        """
        if name not in self._templates:
            logger.warning("Template '%s' does not exist. Creating new.", name)
        self._templates[name] = template
        logger.info("Template '%s' updated", name)
