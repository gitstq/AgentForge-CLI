    while True:
        try:
            user_input = input("You: ").strip()
            if user_input.lower() == "quit":
                break
            if user_input.lower() == "reset":
                agent.reset()
                print("Conversation reset.\n")
                continue

            response = agent.run(user_input)
            print(f"Agent: {response}\n")
        except KeyboardInterrupt:
            print("\nGoodbye!")
            break
