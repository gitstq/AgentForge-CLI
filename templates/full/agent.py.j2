    def _execute_tool_with_retry(
        self,
        tool_name: str,
        tool_args: Dict[str, Any],
        max_retries: int = 3,
    ) -> Any:
        """Execute a tool with retry logic and exponential backoff."""
        import time

        for attempt in range(max_retries):
            try:
                result = self.tools.execute(tool_name, **tool_args)
                logger.info("Tool %s succeeded (attempt %d)", tool_name, attempt + 1)
                return result
            except Exception as e:
                logger.warning(
                    "Tool %s failed (attempt %d/%d): %s",
                    tool_name, attempt + 1, max_retries, e,
                )
                if attempt < max_retries - 1:
                    time.sleep(2 ** attempt)
                else:
                    return f"Error: {e}"

    def save_state(self, filepath: str) -> None:
        """Persist full agent state to a JSON file."""
        state_data = {
            "state": self.state,
            "context": self.context.to_dict(),
            "memory": self.memory.to_dict(),
            "saved_at": datetime.now().isoformat(),
        }
        with open(filepath, "w", encoding="utf-8") as f:
            json.dump(state_data, f, indent=2)
        logger.info("State saved to %s", filepath)

    def load_state(self, filepath: str) -> None:
        """Restore agent state from a JSON file."""
        try:
            with open(filepath, "r", encoding="utf-8") as f:
                data = json.load(f)
            self.state = data.get("state", {})
            if "context" in data:
                self.context.from_dict(data["context"])
            if "memory" in data:
                self.memory.from_dict(data["memory"])
            logger.info("State loaded from %s", filepath)
        except (FileNotFoundError, json.JSONDecodeError) as e:
            logger.error("Failed to load state: %s", e)

    def reset(self) -> None:
        """Reset the agent to a clean state."""
        self.context.clear()
        self.memory.clear()
        self.state.clear()
        logger.info("Agent reset to clean state")


