class TestMemoryStore(unittest.TestCase):
    """Tests for the MemoryStore class."""

    def setUp(self) -> None:
        self.memory = MemoryStore(max_entries=5)

    def test_store_and_count(self) -> None:
        self.memory.store("user", "Hello")
        self.assertEqual(self.memory.count(), 1)

    def test_search(self) -> None:
        self.memory.store("user", "The weather is nice today")
        results = self.memory.search("weather")
        self.assertEqual(len(results), 1)

    def test_max_entries_eviction(self) -> None:
        for i in range(10):
            self.memory.store("user", f"message {i}")
        self.assertLessEqual(self.memory.count(), 5)

    def test_clear(self) -> None:
        self.memory.store("user", "test")
        self.memory.clear()
        self.assertEqual(self.memory.count(), 0)

    def test_persistence(self) -> None:
        self.memory.store("user", "persist me")
        data = self.memory.to_dict()
        new_memory = MemoryStore()
        new_memory.from_dict(data)
        self.assertEqual(new_memory.count(), 1)

    def test_get_by_role(self) -> None:
        self.memory.store("user", "hello")
        self.memory.store("assistant", "hi there")
        self.memory.store("user", "how are you")
        user_entries = self.memory.get_by_role("user")
        self.assertEqual(len(user_entries), 2)


class TestPromptManager(unittest.TestCase):
    """Tests for the PromptManager class."""

    def setUp(self) -> None:
        self.prompts = PromptManager()

    def test_get_system_prompt(self) -> None:
        prompt = self.prompts.get_prompt("system", agent_name="TestBot")
        self.assertIn("TestBot", prompt)

    def test_get_unknown_prompt(self) -> None:
        with self.assertRaises(KeyError):
            self.prompts.get_prompt("nonexistent")

    def test_register_custom_prompt(self) -> None:
        self.prompts.register("custom", "Hello {name}!")
        result = self.prompts.get_prompt("custom", name="World")
        self.assertEqual(result, "Hello World!")

    def test_list_templates(self) -> None:
        templates = self.prompts.list_templates()
        self.assertIn("system", templates)


