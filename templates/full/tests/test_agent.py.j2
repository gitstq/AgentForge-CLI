class TestSettings(unittest.TestCase):
    """Tests for the Settings configuration class."""

    def test_default_settings(self) -> None:
        """Settings should have sensible defaults."""
        settings = Settings()
        self.assertEqual(settings.llm_provider, "openai")
        self.assertEqual(settings.llm_model, "gpt-4")
        self.assertEqual(settings.max_iterations, 10)

    def test_validate_missing_api_key(self) -> None:
        """Validation should fail when API key is missing."""
        settings = Settings(llm_api_key="")
        errors = settings.validate()
        self.assertTrue(any("LLM_API_KEY" in e for e in errors))

    def test_validate_invalid_temperature(self) -> None:
        """Validation should fail for out-of-range temperature."""
        settings = Settings(llm_api_key="test-key", llm_temperature=5.0)
        errors = settings.validate()
        self.assertTrue(any("TEMPERATURE" in e for e in errors))

    def test_validate_valid_settings(self) -> None:
        """Validation should pass for valid settings."""
        settings = Settings(llm_api_key="test-key", llm_temperature=0.7)
        errors = settings.validate()
        self.assertEqual(len(errors), 0)


class TestToolRegistry(unittest.TestCase):
    """Tests for the ToolRegistry class."""

    def setUp(self) -> None:
        self.registry = ToolRegistry()

    def test_register_tool(self) -> None:
        """Tools should be registerable and listable."""
        self.registry.register("test_tool", lambda x: x, description="A test tool")
        tools = self.registry.list_tools()
        self.assertEqual(len(tools), 1)
        self.assertEqual(tools[0]["name"], "test_tool")

    def test_execute_tool(self) -> None:
        """Registered tools should be executable."""
        self.registry.register("add", lambda a, b: a + b)
        result = self.registry.execute("add", a=1, b=2)
        self.assertEqual(result, 3)

    def test_execute_unknown_tool(self) -> None:
        """Executing an unknown tool should raise KeyError."""
        with self.assertRaises(KeyError):
            self.registry.execute("nonexistent")

    def test_unregister_tool(self) -> None:
        """Tools should be removable from the registry."""
        self.registry.register("temp", lambda: None)
        self.registry.unregister("temp")
        self.assertEqual(len(self.registry.list_tools()), 0)

    def test_setup_default_tools(self) -> None:
        """Default tools should be registered successfully."""
        setup_default_tools(self.registry)
        tools = self.registry.list_tools()
        self.assertTrue(len(tools) >= 3)
        names = [t["name"] for t in tools]
        self.assertIn("calculator", names)


