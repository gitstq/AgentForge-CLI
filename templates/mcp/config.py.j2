"""
Configuration management for {project_name} MCP Server.

Uses environment variables for all sensitive values.
"""

import os
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Settings:
    """
    MCP Server settings loaded from environment variables.
    """

    # Server Configuration
    server_name: str = "{project_name}"
    server_version: str = "{version}"
    host: str = field(default_factory=lambda: os.getenv("MCP_HOST", "localhost"))
    port: int = field(default_factory=lambda: int(os.getenv("MCP_PORT", "3000")))

    # LLM Configuration (optional, for agent-enhanced tools)
    llm_provider: str = field(default_factory=lambda: os.getenv("LLM_PROVIDER", "openai"))
    llm_model: str = field(default_factory=lambda: os.getenv("LLM_MODEL", "gpt-4"))
    llm_api_key: str = field(default_factory=lambda: os.getenv("LLM_API_KEY", ""))

    # Logging
    log_level: str = field(default_factory=lambda: os.getenv("LOG_LEVEL", "INFO"))
    debug: bool = field(
        default_factory=lambda: os.getenv("DEBUG", "false").lower() == "true"
    )

    def validate(self) -> list:
        """Validate settings and return a list of errors."""
        errors = []
        if self.port < 1 or self.port > 65535:
            errors.append("MCP_PORT must be between 1 and 65535")
        return errors


def load_settings() -> Settings:
    """Load settings from environment variables."""
    try:
        from dotenv import load_dotenv
        load_dotenv()
    except ImportError:
        pass

    settings = Settings()
    errors = settings.validate()
    if errors:
        import logging
        for err in errors:
            logging.getLogger(__name__).warning("Config issue: %s", err)

    return settings
